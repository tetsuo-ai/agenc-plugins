{
  "name": "@tetsuo-ai/agenc-plugins",
  "version": "0.2.5",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build-manifest.mjs",
    "validate:copy": "node validate-copy.mjs",
    "validate": "node validate.mjs",
    "validate:core": "node validate-core.mjs",
    "validate:built": "node validate-plugins-built.mjs",
    "validate:stonks-core": "node validate-stonks-core.mjs",
    "validate:stonks-built": "node validate-stonks-built.mjs",
    "validate:stonks-visuals": "node capture-stonks-visuals.mjs",
    "test:stonks": "node --test tests/stonks-copilot-contract.test.mjs tests/stonks-data-regression.test.mjs tests/stonks-security.test.mjs tests/stonks-metadata.test.mjs",
    "validate:core:remote": "node validate-core-remote.mjs",
    "test": "npm run validate:copy && npm run build && node --test tests/*.test.mjs && npm run validate"
  },
  "engines": {
    "node": ">=22"
  }
}
